{
  "name": "dsh-delete-session",
  "version": "0.1.0",
  "private": true,
  "description": "Permanent conversation deletion for DeepSeek Harness desktop, with guarded local patches and Better Sidebar integration.",
  "license": "MIT",
  "engines": {"node": ">=22"},
  "repository": {"type": "git", "url": "https://github.com/qiaozheng9/dsh-delete-session.git"},
  "homepage": "https://github.com/qiaozheng9/dsh-delete-session#readme",
  "bugs": {"url": "https://github.com/qiaozheng9/dsh-delete-session/issues"},
  "keywords": ["deepseek-harness", "dsh-plugin", "permanent-delete", "session-management", "better-sidebar"],
  "type": "module",
  "scripts": {
    "inspect": "node scripts/inspect.mjs",
    "build": "node scripts/build.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepare:local": "node scripts/manage.mjs prepare",
    "verify:runtime": "node scripts/run-runtime.mjs",
    "verify:ui": "node scripts/smoke-ui.mjs",
    "verify:install": "node scripts/smoke-install.mjs",
    "verify:installed": "node scripts/verify-installed.mjs",
    "install:local": "node scripts/manage.mjs install",
    "status": "node scripts/manage.mjs status",
    "uninstall:local": "node scripts/manage.mjs uninstall"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "playwright-core": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

{
  "name": "dsh-delete-session",
  "version": "0.1.0",
  "private": true,
  "description": "Permanent conversation deletion for a supported, locally patched DeepSeek Harness desktop build.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json"},
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "engines": {"node": ">=24", "dsh": "=0.2.1-rc.5"},
  "repository": {"type": "git", "url": "https://github.com/qiaozheng9/dsh-delete-session.git", "directory": "plugin"},
  "homepage": "https://github.com/qiaozheng9/dsh-delete-session#readme",
  "keywords": ["dsh-plugin", "deepseek-harness", "session-management"],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-api-session-controller"]}
  },
  "license": "MIT"
}
